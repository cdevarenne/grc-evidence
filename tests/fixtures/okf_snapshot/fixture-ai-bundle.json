   "terms-and-conditions": {
    "parts": [
     {
      "name": "rules-of-engagement",
      "prose": "A finding may be suppressed only by a suppression concept in the knowledge bundle that matches it exactly (tool, rule id, target, and optionally a message fragment; no wildcards), names a human owner and a reason, carries a human `verified` entry, and expires at most 90 days after approval. A false positive leaves the control's status and is named in the results' remarks; an accepted risk keeps the control not-satisfied and is recorded as a deviation-approved risk. An expired suppression no longer applies.",
      "title": "Suppression policy"
     },
     {
      "name": "methodology",
      "prose": "A finding maps to a control only through a `rule_ids` declaration in the knowledge bundle. A finding no declaration covers is a coverage gap, recorded as an open risk, never as a control finding. A clean automated scan evidences a control but never attests it.",
      "title": "Grounding rule"
     }
    ]
   },
   "uuid": "7a29b0fe-8610-51da-b51c-35070d32d39b"
  }
