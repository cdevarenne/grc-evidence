{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "grc-evidence findings.json",
  "description": "Normalized, deduplicated scanner findings, sorted by tool, rule id, target, and message.",
  "type": "object",
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version; additive changes bump the minor."
    },
    "collectors": {
      "type": "array",
      "items": {"enum": ["scm", "changes"]},
      "description": "collect/github-findings.json only: the GitHub collectors that ran. A collector not listed did not run."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "tool",
        "rule_id",
        "severity",
        "target",
        "message",
        "tags"
      ],
      "properties": {
        "tool": {
          "enum": [
            "semgrep",
            "trivy",
            "checkov",
            "conftest",
            "github"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "target": {
          "type": "string",
          "description": "Repo-relative path, POSIX separators; for tool github, github:<owner>/<name> or github:<owner>/<name>#<number>."
        },
        "message": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
