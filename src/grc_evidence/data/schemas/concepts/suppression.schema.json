{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "grc-evidence suppression concept (extension fields)",
  "description": "A reviewed decision about one exact finding. Syntax only: the 90-day window, the '# Reason' section and an accepted risk that must map to a control are load-time checks in okf_lib.",
  "type": "object",
  "required": [
    "type",
    "kind",
    "finding",
    "owner",
    "approved",
    "expires"
  ],
  "properties": {
    "type": {
      "const": "Suppression"
    },
    "kind": {
      "enum": [
        "false-positive",
        "accepted-risk"
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "tool",
        "rule_id",
        "target"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?\\[]+$",
          "description": "exact; no wildcards"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?\\[]+$",
          "description": "exact; no wildcards"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?\\[]+$",
          "description": "exact; no wildcards"
        },
        "message_contains": {
          "type": "string"
        }
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^human:\\S+",
      "description": "a person, human:<name>"
    },
    "approved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date, YYYY-MM-DD"
    },
    "expires": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date, YYYY-MM-DD"
    }
  }
}
